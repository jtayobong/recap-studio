{
  "name": "recap-studio",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "A local, Wrapped-inspired story video editor that runs entirely in the browser.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test -c playwright.prod.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:desktop": "playwright test -c playwright.desktop.config.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "mediabunny": "^1.65.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.54.0",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
